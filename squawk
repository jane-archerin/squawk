#!/usr/bin/env python3
"""
squawk — drive the agent comms channel from any project directory.

The channel lives in the directory you run this from: <cwd>/channel.jsonl
(override with the SQUAWK_CHANNEL environment variable).

Usage:
    squawk                         # bring up ALL three: panel + Claude + Codex
    squawk up                      # same as bare `squawk`
    squawk serve                   # just the web panel (no agents)
    squawk say <from> <message>    # post a message (e.g. squawk say host "hi")
    squawk read [...]              # read the conversation (flags pass through)
    squawk watch [...]             # block until there's a new message to answer
    squawk claude <run>            # just the Claude auto-responder
    squawk codex <run|install|...> # just the Codex auto-responder / service
    squawk help                    # this help

`squawk up` starts the live web panel plus a read-only background responder for
each installed assistant CLI (Claude via `claude`, Codex via `codex`). They reply
to each other and to you until you Ctrl-C, which stops all three. The agents run
headless and read-only — they never edit files; they just talk in the channel.
"""
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import webbrowser

HOME = os.path.dirname(os.path.realpath(__file__))  # where the scripts live (follows symlinks)

SUBCOMMANDS = {
    "serve": "server.py",
    "say": "say.py",
    "read": "read.py",
    "watch": "wait_for_reply.py",
    "claude": "claude_watch.py",
    "codex": "codex_watch.py",
}

# Minimum interpreter per script. codex_watch needs 3.11+ (tomllib); the rest 3.9+.
MIN_PY = {"codex_watch.py": (3, 11)}
PY_CANDIDATES = ["python3.14", "python3.13", "python3.12", "python3.11",
                 "/opt/homebrew/bin/python3", "/usr/local/bin/python3", "python3"]


def python_for(script):
    """Return an interpreter path that satisfies the script's minimum version."""
    need = MIN_PY.get(os.path.basename(script), (3, 9))
    if sys.version_info[:2] >= need:
        return sys.executable
    for cand in PY_CANDIDATES:
        path = shutil.which(cand) if not os.path.isabs(cand) else (cand if os.path.exists(cand) else None)
        if not path:
            continue
        try:
            out = subprocess.run([path, "-c", "import sys;print('%d.%d'%sys.version_info[:2])"],
                                 capture_output=True, text=True, timeout=5)
            major, minor = (int(x) for x in out.stdout.strip().split("."))
            if (major, minor) >= need:
                return path
        except Exception:
            continue
    return None


def run_script(script, rest):
    py = python_for(script)
    if not py:
        need = MIN_PY.get(os.path.basename(script))
        sys.exit("squawk: %s needs Python %d.%d+, which wasn't found on PATH." % (script, *need))
    path = os.path.join(HOME, script)
    try:
        return subprocess.run([py, path, *rest]).returncode
    except KeyboardInterrupt:
        return 0


def port_in_use(port):
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            return False
        except OSError:
            return True


def spawn(script, rest):
    py = python_for(script)
    if not py:
        return None
    return subprocess.Popen([py, os.path.join(HOME, script), *rest], start_new_session=True)


def terminate(children):
    for _, proc in children:
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
    deadline = time.time() + 6
    for _, proc in children:
        while proc.poll() is None and time.time() < deadline:
            time.sleep(0.1)
    for _, proc in children:
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass


def up():
    port = int(os.environ.get("PORT", "4321"))
    url = "http://localhost:%d" % port
    have_claude = bool(shutil.which("claude"))
    have_codex = bool(shutil.which("codex"))

    children = []  # (name, Popen)

    if port_in_use(port):
        print("• Panel: port %d already in use — reusing the panel already there." % port)
    else:
        srv = spawn("server.py", [])
        if srv:
            children.append(("panel", srv))

    if have_claude:
        c = spawn("claude_watch.py", ["run"])
        if c:
            children.append(("claude", c))
    if have_codex:
        c = spawn("codex_watch.py", ["run"])
        if c:
            children.append(("codex", c))

    agents = [n for n, _ in children if n in ("claude", "codex")]
    print("\n🛰️  squawk is up — %s" % url)
    print("   channel : %s" % os.path.join(os.getcwd(), "channel.jsonl"))
    if agents:
        print("   agents  : %s (read-only, auto-reply in the channel)" % ", ".join(agents))
    missing = [name for name, have in (("claude", have_claude), ("codex", have_codex)) if not have]
    if missing:
        print("   missing : %s CLI not found — that side stays quiet." % ", ".join(missing))
    print("   post    : squawk say host \"your message\"   (or type in the panel)")
    print("   stop    : Ctrl-C  (stops the panel and both agents)\n")

    # Open the panel once the server has had a moment to bind.
    threading.Thread(target=lambda: (time.sleep(1.2), webbrowser.open(url)), daemon=True).start()

    stop = {"flag": False}

    def handle(*_):
        stop["flag"] = True
    for sig in (signal.SIGINT, signal.SIGTERM, getattr(signal, "SIGHUP", None)):
        if sig is not None:
            signal.signal(sig, handle)

    try:
        while not stop["flag"]:
            for name, proc in children:
                code = proc.poll()
                if code is not None:
                    print("\n• %s exited (code %s) — shutting the rest down." % (name, code))
                    stop["flag"] = True
                    break
            time.sleep(1)
    finally:
        print("Stopping squawk…")
        terminate(children)
    return 0


def main():
    args = sys.argv[1:]

    if args and args[0] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return

    if not args or args[0] == "up":
        sys.exit(up())

    if args[0] not in SUBCOMMANDS:
        if args[0].startswith("-"):
            sys.exit(up())  # tolerate stray flags → just bring everything up
        sys.exit("squawk: unknown command %r\nTry: up, serve, say, read, watch, "
                 "claude, codex, or 'squawk help'." % args[0])

    sys.exit(run_script(SUBCOMMANDS[args[0]], args[1:]))


if __name__ == "__main__":
    main()
